@model IPagedList<Product>
@using X.PagedList.Mvc.Core;
@using X.PagedList;

@{
    var productStockData = ViewBag.ProductStockData as Dictionary<int, bool> ?? new Dictionary<int, bool>();
}

@section Styles {
    <style>
        .image-container {
            overflow: hidden;
            position: relative;
        }

        .product-image {
            width: 100%;
            height: 250px;
            object-fit: cover;
            transition: transform 0.3s ease;
        }

        .image-container:hover .product-image {
            transform: scale(1.1);
        }
        
        .sold-out-overlay {
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0, 0, 0, 0.6);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10;
        }
        
        .sold-out-badge {
            background: #dc3545;
            color: white;
            padding: 10px 20px;
            border-radius: 8px;
            font-weight: bold;
            font-size: 16px;
            text-transform: uppercase;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.3);
        }

        .egp-price {
            font-size: 14px;
            font-weight: 500;
            color: #666;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            margin-top: 5px;
            text-wrap:nowrap;
        }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
            transition: 0.3s ease-in-out;
        }

        .btn-outline-dark {
            border-radius: 30px;
            font-weight: 500;
            transition: all 0.3s ease-in-out;
        }

            .btn-outline-dark:hover {
                background-color: #000;
                color: #fff;
            }

        .pagination .page-link {
            border-radius: 0.5rem !important;
            padding: 4px 10px;
            margin: 0 2px;
            font-size: 0.8rem;
            color: #e83e8c;
            font-weight: 500;
            transition: all 0.3s ease;
        }

        .pagination .page-item.active .page-link {
            background: #e83e8c;
            color: #fff;
            border-color: #e83e8c;
        }

        .pagination .page-link:hover {
            background: #fce4ec;
            color: #ad1457;
        }


        .no-products {
            text-align: center;
            padding: 100px 20px;
            color: #666;
        }

            .no-products i {
                font-size: 80px;
                color: #ddd;
                margin-bottom: 20px;
            }

            .no-products h3 {
                font-weight: bold;
                margin-bottom: 10px;
            }

            .no-products p {
                font-size: 1rem;
                color: #999;
            }

            .no-products a.btn {
                margin-top: 15px;
                border-radius: 25px;
                padding: 10px 25px;
            }

        #home .hero {
            position: relative;
            background-image: url('/Images/jj.jpg');
            background-size: cover;
            background-repeat: no-repeat;
            background-position: center center;
            width: 100%;
            object-fit: cover;
            border-radius:24px;
            /* aspect-ratio: 6/3; */
            height:50vh;
            z-index: 0;
        }

        @@media (min-width: 992px) {
            #home .hero {
                height: 100vh; 
            }
        }


        .fc-white {
            color: #FFFFFF;
        }

        .btn-custom {
            border-radius: 999999px;
            background-color: black;
            color: white;
            border: none;
            transition: .2s;
        }

            .btn-custom:hover {
                background-color: #222;
            }

        /* Mobile-only: Square product images */
        @@media (max-width: 576px) {
            .col {
                max-width: 45%;
                flex: 0 0 45%;
            }
            
            .card .image-container {
                aspect-ratio: 1 / 1;
                padding: 0 !important;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #fff;
                overflow: hidden;
            }
            
            .product-image {
                height: 100% !important;
                width: 100% !important;
                object-fit: cover !important;
                object-position: center;
                transform: none !important;
                border-radius: 0 !important;
            }
            
            .image-container:hover .product-image {
                transform: none !important;
            }
            
            .card-body {
                padding: 0.5rem !important;
            }
            
            .card-footer {
                padding: 0.5rem !important;
            }
            
            .card h5 {
                font-size: 0.85rem;
                margin-bottom: 0.25rem;
            }
            
            .egp-price {
                font-size: 0.75rem;
            }
            
            .btn {
                font-size: 0.75rem;
                padding: 0.375rem 0.75rem;
            }
            
            .sold-out-badge {
                padding: 6px 12px;
                font-size: 0.75rem;
            }
        }
    </style>
}


<!-- Hero Section -->
<section id="home" class="pt-4 pb-5">
    <div class="container ">
        <div class="hero p-4">
            <div class="row fc-white align-content-end h-100 z-3">
                <div class="row justify-content-between align-items-center">
                    <div class="col-12">
                        <h1 class="fw-bolder">DAJDAJ NEW COLLECTION</h1>
                    </div>
                </div>
                <div class="row justify-content-between align-items-center">
                    <div class="col-12 col-lg-7">

                        <p>
                            Where beauty meets elegance - just for YOU ♡
                        </p>
                    </div>
                    <div class="col-12 col-lg-5 text-lg-end text-start">
                        @{
                            var firstProductId = Model.FirstOrDefault()?.Id ?? 0;
                        }
                        <a href="@Url.Action("Details", "Home", new { id = firstProductId })"
                           class="btn-custom px-5 py-2 fw-bolder"
                           style="background-color: #f06292; color: white; border: none; border-radius: 8px;">
                            Shop Now
                        </a>
                    </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Main Product Section -->
<section class="pb-5 pt-2">
    <div class="container px-4 px-lg-5 mt-0">
        @if (Model != null && Model.Any())
        {
            <div class="row gx-4 gx-lg-5 row-cols-2 row-cols-md-3 row-cols-xl-4 justify-content-center">
                @foreach (var item in Model)
                {
                    var isSoldOut = productStockData.ContainsKey(item.Id) && productStockData[item.Id];
                    
                    <div class="col mb-5">
                        <div class="card h-100">
                            <!-- Product image -->
                            <a href="/Customer/Home/Details/@item.Id">
                                <div class="image-container" style="padding:8px">
                                    @if (!string.IsNullOrEmpty(item.Img))
                                    {
                                        <img class="product-image" src="~/@item.Img" alt="Product Image" style="border-radius:4px"/>
                                    }
                                    else
                                    {
                                        <img class="product-image" src="https://placehold.co/600x400/png" alt="No Image" />
                                    }
                                    
                                    @if (isSoldOut)
                                    {
                                        <div class="sold-out-overlay">
                                            <div class="sold-out-badge">
                                                <i class="fas fa-times-circle me-2"></i>SOLD OUT
                                            </div>
                                        </div>
                                    }
                                </div>
                            </a>
                            <!-- Product details -->
                            <div class="card-body">
                                <div class="text-center">
                                    <h5 class="fw-bolder">@item.Name</h5>
                                    <div class="d-flex align-items-center gap-1 justify-content-center">
                                @if (item.OldPrice > 0)
                                        {
                                            <h4 class="egp-price text-decoration-line-through text-body-tertiary fw-lighter"> @item.OldPrice</h4>
                                        <h4 class="egp-price">@item.Price.ToString("0.00") EGP</h4>
                                        }
                                        else
                                        {
                                            <h4 class="egp-price">@item.Price.ToString("0.00") EGP</h4>
                                        }
                                      
                                    </div>
                                   
                                </div>
                            </div>
                            <!-- Product actions -->
                            <div class="card-footer p-4 pt-0 border-top-0 bg-transparent">
                                <div class="text-center">
                                    @if (isSoldOut)
                                    {
                                        <a class="btn btn-secondary mt-auto disabled" href="javascript:void(0)">
                                            <i class="fas fa-times-circle me-1"></i>Out of Stock
                                        </a>
                                    }
                                    else
                                    {
                                        <a class="btn btn-outline-dark mt-auto" href="/Customer/Home/Details/@item.Id">View Details</a>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination -->
            <div class="d-flex justify-content-center mt-4">
                @Html.PagedListPager(
                Model,
                        page => Url.Action("Index", new { page }),
                        new PagedListRenderOptions
                        {
                            LiElementClasses = new[] { "page-item" },
                            PageClasses = new[] { "page-link", "rounded-pill", "shadow-sm", "text-dark" },
                            UlElementClasses = new[] { "pagination", "pagination-lg", "gap-2", "border-0" },
                            DisplayLinkToFirstPage = PagedListDisplayMode.Always,
                            DisplayLinkToLastPage = PagedListDisplayMode.Always,
                            DisplayLinkToPreviousPage = PagedListDisplayMode.Always,
                            DisplayLinkToNextPage = PagedListDisplayMode.Always,
                            LinkToFirstPageFormat = "<i class='bi bi-chevron-double-left'></i>",
                            LinkToPreviousPageFormat = "<i class='bi bi-chevron-left'></i>",
                            LinkToNextPageFormat = "<i class='bi bi-chevron-right'></i>",
                            LinkToLastPageFormat = "<i class='bi bi-chevron-double-right'></i>"
                        }
                        )
        </div>
                }
        else
        {
            <div class="no-products">
                <i class="fas fa-box-open"></i>
                <h3>No Products Available</h3>
                <p>@ViewBag.Message</p>
                @if (User.IsInRole("Admin"))
                {
                    <a href="/Admin/Product/Create" class="btn btn-primary">Add New Product</a>
                }
            </div>
        }
    </div>
</section>