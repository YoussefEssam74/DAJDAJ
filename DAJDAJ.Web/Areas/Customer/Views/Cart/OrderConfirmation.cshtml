@model int
@{
    Layout = "_Customer";
}

<style>
    .confirmation-card {
        background: white;
        border-radius: 20px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.1);
        padding: 3rem;
        text-align: center;
    }

    .success-icon {
        width: 100px;
        height: 100px;
        border-radius: 50%;
        background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 2rem;
        animation: scaleIn 0.5s ease-out;
    }

    .success-icon i {
        font-size: 3rem;
        color: white;
    }

    @@keyframes scaleIn {
        from {
            transform: scale(0);
            opacity: 0;
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    .confirmation-title {
        font-size: 2rem;
        font-weight: bold;
        color: #212529;
        margin-bottom: 1rem;
    }

    .order-number {
        font-size: 1.5rem;
        color: #ff6b9d;
        font-weight: 600;
        margin: 1.5rem 0;
        padding: 1rem;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-radius: 10px;
    }

    .confirmation-message {
        color: #6c757d;
        font-size: 1.1rem;
        margin-bottom: 2rem;
    }

    .btn-view-orders {
        background: linear-gradient(135deg, #ff6b9d 0%, #c44569 100%);
        border: none;
        color: white;
        padding: 0.75rem 1.5rem;
        border-radius: 25px;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        margin: 0.5rem;
        width: auto;
    }

    .btn-view-orders:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 20px rgba(255, 107, 157, 0.4);
        color: white;
    }

    .btn-continue-shopping {
        background: white;
        border: 2px solid #ff6b9d;
        color: #ff6b9d;
        padding: 0.75rem 1.5rem;
        border-radius: 25px;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        text-decoration: none;
        display: inline-block;
        margin: 0.5rem;
        width: auto;
    }

    .btn-continue-shopping:hover {
        background: #ff6b9d;
        color: white;
        transform: translateY(-2px);
    }

    .redirect-info {
        margin-top: 2rem;
        color: #6c757d;
        font-size: 0.9rem;
    }

    .redirect-info .spinner-border {
        width: 1rem;
        height: 1rem;
        border-width: 0.15rem;
    }

    /* Mobile responsive styles */
    @@media (max-width: 768px) {
        .confirmation-card {
            padding: 2rem 1.5rem;
        }

        .confirmation-title {
            font-size: 1.5rem;
        }

        .order-number {
            font-size: 1.2rem;
            padding: 0.75rem;
        }

        .confirmation-message {
            font-size: 1rem;
        }

        .btn-view-orders,
        .btn-continue-shopping {
            display: block;
            width: 100%;
            max-width: 300px;
            margin: 0.5rem auto;
            padding: 0.75rem 1rem;
            font-size: 0.95rem;
        }

        .success-icon {
            width: 80px;
            height: 80px;
        }

        .success-icon i {
            font-size: 2.5rem;
        }
    }

    @@media (max-width: 480px) {
        .btn-view-orders,
        .btn-continue-shopping {
            font-size: 0.9rem;
            padding: 0.65rem 1rem;
        }
    }
</style>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="confirmation-card">
                <div class="success-icon">
                    <i class="bi bi-check-lg"></i>
                </div>
                
                <h1 class="confirmation-title">Order Confirmed!</h1>
                
                <p class="confirmation-message">
                    Thank you for your order. We've received your order and will start processing it soon.
                </p>

                <div class="order-number">
                    <i class="bi bi-receipt me-2"></i>
                    Order Number: <strong>#@(1000 + Model)</strong>
                </div>

                <div class="mt-4 d-flex flex-column flex-md-row justify-content-center align-items-center">
                    <a asp-area="Customer" asp-controller="Order" asp-action="MyOrders" class="btn-view-orders">
                        <i class="bi bi-bag-check me-2"></i>View My Orders
                    </a>
                    <a asp-area="Customer" asp-controller="Home" asp-action="Index" class="btn-continue-shopping">
                        <i class="bi bi-shop me-2"></i>Continue Shopping
                    </a>
                </div>

                <div class="redirect-info">
                    <!-- Redirect info removed as per the change request -->
                </div>
            </div>
        </div>
    </div>
</div>