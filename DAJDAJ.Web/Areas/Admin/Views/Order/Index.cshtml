@{
    ViewBag.PageTitle = "Orders Management";
    ViewBag.CardTitle = "View Orders";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

@Html.AntiForgeryToken()

<!-- Bulk Status Change -->
<div class="card shadow mb-3">
    <div class="card-body">
        <h5 class="mb-3"><i class="fas fa-exchange-alt"></i> Change Orders Status</h5>
        <div class="row">
            <div class="col-12 col-md-3 mb-3 mb-md-0">
                <label for="fromStatus"><strong>FROM Status:</strong></label>
                <select id="fromStatus" class="form-control">
                    <option value="">All Statuses</option>
                    <option value="Pending">Pending</option>
                    <option value="Proccessing">Processing</option>
                    <option value="Booked">Booked</option>
                    <option value="Shipped">Shipped</option>
                    <option value="Earned">Earned</option>
                    <option value="Return">Return</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
            </div>
            <div class="col-12 col-md-3 mb-3 mb-md-0">
                <label for="toStatus"><strong>TO Status:</strong></label>
                <select id="toStatus" class="form-control">
                    <option value="">Select Status...</option>
                    <option value="Pending">Pending</option>
                    <option value="Proccessing">Processing</option>
                    <option value="Booked">Booked</option>
                    <option value="Shipped">Shipped</option>
                    <option value="Earned">Earned</option>
                    <option value="Return">Return</option>
                    <option value="Cancelled">Cancelled</option>
                </select>
            </div>
            <div class="col-12 col-md-6">
                <label class="d-none d-md-block">&nbsp;</label>
                <div class="d-flex flex-column flex-md-row gap-2">
                    <button type="button" id="changeStatus" class="btn btn-primary btn-lg mb-2 mb-md-0" style="margin-right: 10px;">
                        <i class="fas fa-exchange-alt"></i> <span class="d-none d-sm-inline">Change Status</span><span class="d-inline d-sm-none">Change</span>
                    </button>
                    <button type="button" id="printNewOrders" class="btn btn-success btn-lg mb-2 mb-md-0" style="margin-right: 10px;">
                        <i class="fas fa-print"></i> <span class="d-none d-sm-inline">Print New Orders</span><span class="d-inline d-sm-none">Print</span>
                    </button>
                    <button type="button" id="exportFiltered" class="btn btn-warning btn-lg mb-2 mb-md-0">
                        <i class="fas fa-file-excel"></i> <span class="d-none d-sm-inline">Export to Excel</span><span class="d-inline d-sm-none">Export</span>
                    </button>
                </div>
            </div>
        </div>
        <!-- ID Range Filter for Export -->
        <div class="row mt-3">
            <div class="col-12">
                <label><strong>Export ID Range (Optional):</strong></label>
                <div class="d-flex flex-column flex-md-row gap-2 align-items-md-end">
                    <div class="flex-fill">
                        <label for="fromId" class="small">From ID:</label>
                        <input type="number" id="fromId" class="form-control" placeholder="e.g., 100" min="1" />
                    </div>
                    <div class="flex-fill">
                        <label for="toId" class="small">To ID:</label>
                        <input type="number" id="toId" class="form-control" placeholder="e.g., 150" min="1" />
                    </div>
                    <div class="flex-fill">
                        <small class="text-muted d-block">Leave empty to export all filtered orders</small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Other Actions -->
<div class="mb-4 d-grid d-md-block">
    <a href="@Url.Action("ExportToExcel", "Order", new { area = "Admin" })" class="btn btn-secondary btn-lg">
        <i class="fas fa-download"></i> Export All to Excel
    </a>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">@ViewBag.CardTitle</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="mytable" class="table table-bordered" width="100%" cellspacing="0">
                <thead class="thead-dark">
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Phone</th>  
                        <th>City</th>
                        <th>Order Status</th>
                        <th>Total Price</th>
                        <th>Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Order.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
}
