@{
    ViewData["Title"] = "Bulk Status Update";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<style>
    .order-checkbox {
        width: 18px !important;
        height: 18px !important;
        cursor: pointer;
        min-width: auto !important;
        min-height: auto !important;
        display: inline-block !important;
        margin: 0 auto;
    }
    .select-all-checkbox {
        width: 20px !important;
        height: 20px !important;
        cursor: pointer;
        min-width: auto !important;
        min-height: auto !important;
        display: inline-block !important;
        margin-right: 5px;
        vertical-align: middle;
    }
    .status-badge {
        padding: 5px 10px;
        border-radius: 4px;
        font-size: 12px;
        font-weight: bold;
    }
    .btn-update {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border: none;
        color: white;
        padding: 10px 30px;
        font-weight: 600;
        transition: all 0.3s;
        width: 100%;
    }
    .btn-update:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
    }
    .selected-count {
        background: #667eea;
        color: white;
        padding: 8px 15px;
        border-radius: 20px;
        font-weight: 600;
        display: inline-block;
        text-align: center;
        width: 100%;
    }

    /* Mobile Responsive Styles */
    @@media (max-width: 768px) {
        .card-header h4 {
            font-size: 1.2rem;
        }
        
        .btn-update {
            padding: 12px 20px;
            font-size: 0.9rem;
            margin-top: 10px;
        }
        
        .selected-count {
            margin-top: 10px;
            font-size: 0.9rem;
        }
        
        #ordersTable {
            font-size: 0.85rem;
        }
        
        #ordersTable th,
        #ordersTable td {
            padding: 8px 4px;
            white-space: nowrap;
        }
        
        .status-badge {
            font-size: 0.7rem;
            padding: 3px 6px;
        }
        
        .table-responsive {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
    }
    
    @@media (max-width: 576px) {
        .form-label {
            font-size: 0.9rem;
        }
        
        .form-select {
            font-size: 0.9rem;
        }
    }
</style>

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="fas fa-edit"></i> Bulk Order Status Update</h4>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-12 col-md-4 mb-3 mb-md-0">
                            <label class="form-label fw-bold">Select New Status:</label>
                            <select id="newStatus" class="form-select">
                                <option value="">-- Choose Status --</option>
                                @foreach (var status in ViewBag.Statuses)
                                {
                                    <option value="@status">@status</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-4 mb-3 mb-md-0 d-flex align-items-end">
                            <button id="updateBtn" class="btn btn-update" disabled>
                                <i class="fas fa-check-circle"></i> Update Selected Orders
                            </button>
                        </div>
                        <div class="col-12 col-md-4 d-flex align-items-end justify-content-md-end">
                            <span class="selected-count">
                                Selected: <span id="selectedCount">0</span> orders
                            </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">All Orders</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table id="ordersTable" class="table table-bordered table-striped table-hover mb-0">
                            <thead>
                                <tr>
                                    <th style="min-width: 80px;">
                                        <input type="checkbox" id="selectAll" class="select-all-checkbox" />
                                        <span class="d-none d-sm-inline">Select All</span>
                                    </th>
                                    <th>ID</th>
                                    <th>Customer</th>
                                    <th>Phone</th>
                                    <th>Price</th>
                                    <th>Status</th>
                                    <th>Date</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Data will be loaded via AJAX -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const API_KEY = 'dajdaj9060'; // You should move this to configuration
        let selectedOrders = new Set();
        let ordersTable;

        $(document).ready(function() {
            // Initialize DataTable
            ordersTable = $('#ordersTable').DataTable({
                responsive: true,
                ajax: {
                    url: '/Admin/Order/GetData',
                    dataSrc: function(json) {
                        return json.data;
                    }
                },
                columns: [
                    {
                        data: 'id',
                        render: function(data, type, row) {
                            return `<input type="checkbox" class="order-checkbox" data-order-id="${data}" />`;
                        },
                        orderable: false,
                        responsivePriority: 1
                    },
                    { 
                        data: 'id',
                        responsivePriority: 2
                    },
                    { 
                        data: 'name',
                        responsivePriority: 3
                    },
                    { data: 'phone' },
                    { 
                        data: 'totalPrice',
                        render: function(data) {
                            return data + ' EGP';
                        }
                    },
                    {
                        data: 'orderStatus',
                        render: function(data) {
                            let badgeClass = 'bg-secondary';
                            if (data === 'Pending') badgeClass = 'bg-warning';
                            else if (data === 'Approved' || data === 'Confirmed') badgeClass = 'bg-success';
                            else if (data === 'Cancelled' || data === 'Rejected') badgeClass = 'bg-danger';
                            else if (data === 'Shipped') badgeClass = 'bg-info';
                            else if (data === 'Booked') badgeClass = 'bg-primary';
                            else if (data === 'Earned') badgeClass = 'bg-success';
                            
                            return `<span class="badge ${badgeClass}">${data}</span>`;
                        },
                        responsivePriority: 4
                    },
                    {
                        data: 'orderDate',
                        render: function(data) {
                            return new Date(data).toLocaleDateString('en-US');
                        }
                    }
                ],
                pageLength: 25,
                lengthMenu: [[10, 25, 50, -1], [10, 25, 50, "All"]],
                language: {
                    search: "Search:",
                    lengthMenu: "Show _MENU_ orders",
                    info: "Showing _START_ to _END_ of _TOTAL_ orders",
                    infoEmpty: "No orders available",
                    infoFiltered: "(filtered from _MAX_ total orders)",
                    paginate: {
                        first: "First",
                        last: "Last",
                        next: "Next",
                        previous: "Prev"
                    }
                }
            });

            // Handle individual checkbox selection
            $('#ordersTable tbody').on('change', '.order-checkbox', function() {
                const orderId = parseInt($(this).data('order-id'));
                if ($(this).is(':checked')) {
                    selectedOrders.add(orderId);
                } else {
                    selectedOrders.delete(orderId);
                }
                updateSelectedCount();
            });

            // Handle select all checkbox
            $('#selectAll').on('change', function() {
                const isChecked = $(this).is(':checked');
                $('.order-checkbox').prop('checked', isChecked);
                
                selectedOrders.clear();
                if (isChecked) {
                    $('.order-checkbox').each(function() {
                        selectedOrders.add(parseInt($(this).data('order-id')));
                    });
                }
                updateSelectedCount();
            });

            // Enable/disable update button based on selections
            $('#newStatus').on('change', updateButtonState);

            // Handle update button click
            $('#updateBtn').on('click', function() {
                const status = $('#newStatus').val();
                if (!status) {
                    Swal.fire('Error', 'Please select a status', 'error');
                    return;
                }

                if (selectedOrders.size === 0) {
                    Swal.fire('Error', 'Please select at least one order', 'error');
                    return;
                }

                Swal.fire({
                    title: 'Are you sure?',
                    text: `Update ${selectedOrders.size} orders to "${status}"?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, update!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        updateOrdersStatus(status);
                    }
                });
            });
        });

        function updateSelectedCount() {
            $('#selectedCount').text(selectedOrders.size);
            updateButtonState();
        }

        function updateButtonState() {
            const hasStatus = $('#newStatus').val() !== '';
            const hasSelection = selectedOrders.size > 0;
            $('#updateBtn').prop('disabled', !(hasStatus && hasSelection));
        }

        function updateOrdersStatus(status) {
            const orderIds = Array.from(selectedOrders);

            $.ajax({
                url: '/api/OrderApi/update-multiple-status',
                method: 'POST',
                headers: {
                    'apiKey': API_KEY,
                    'Content-Type': 'application/json'
                },
                data: JSON.stringify({
                    orderIds: orderIds,
                    status: status
                }),
                success: function(response) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: response.message,
                        confirmButtonText: 'OK'
                    }).then(() => {
                        // Reload the table
                        ordersTable.ajax.reload();
                        // Clear selections
                        selectedOrders.clear();
                        $('#selectAll').prop('checked', false);
                        $('#newStatus').val('');
                        updateSelectedCount();
                    });
                },
                error: function(xhr) {
                    let errorMsg = 'Failed to update orders';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    } else if (xhr.responseText) {
                        errorMsg = xhr.responseText;
                    }
                    
                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: errorMsg
                    });
                }
            });
        }
    </script>
}
