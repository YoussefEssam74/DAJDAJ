@model DAJDAJ.Entities.ViewModels.StockManagementVM

@{
    ViewData["Title"] = "Manage Stock - " + Model.ProductName;
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Manage Stock</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Stock Management</a></li>
                    <li class="breadcrumb-item active">Manage Stock</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-box"></i> @Model.ProductName - Stock by Color & Size
                </h3>
                <div class="card-tools">
                    <a asp-action="AddStock" asp-route-productId="@Model.ProductId" class="btn btn-success btn-sm">
                        <i class="fas fa-plus"></i> Add New Stock
                    </a>
                </div>
            </div>
            
            <form asp-action="UpdateStock" method="post">
                <input type="hidden" asp-for="ProductId" />
                <input type="hidden" asp-for="ProductName" />
                
                <div class="card-body">
                    @if (Model.ColorSizeStocks.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th>Color</th>
                                        <th>Size</th>
                                        <th>Quantity</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.ColorSizeStocks.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                <input type="hidden" asp-for="ColorSizeStocks[i].Id" />
                                                <input type="hidden" asp-for="ColorSizeStocks[i].Color" />
                                                <strong>@Model.ColorSizeStocks[i].Color</strong>
                                            </td>
                                            <td>
                                                <input type="hidden" asp-for="ColorSizeStocks[i].Size" />
                                                <strong>@Model.ColorSizeStocks[i].Size</strong>
                                            </td>
                                            <td>
                                                <input type="number" 
                                                       asp-for="ColorSizeStocks[i].Quantity" 
                                                       class="form-control form-control-sm" 
                                                       min="0" 
                                                       style="max-width: 120px;" />
                                                <span asp-validation-for="ColorSizeStocks[i].Quantity" class="text-danger"></span>
                                            </td>
                                            <td>
                                                @if (Model.ColorSizeStocks[i].IsSoldOut)
                                                {
                                                    <span class="badge badge-danger">
                                                        <i class="fas fa-times-circle"></i> Sold Out
                                                    </span>
                                                }
                                                else if (Model.ColorSizeStocks[i].IsLowStock)
                                                {
                                                    <span class="badge badge-warning">
                                                        <i class="fas fa-exclamation-triangle"></i> Low Stock
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-success">
                                                        <i class="fas fa-check-circle"></i> In Stock
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> No stock records found for this product. 
                            <a asp-action="AddStock" asp-route-productId="@Model.ProductId" class="alert-link">
                                Add stock for available colors and sizes
                            </a>
                        </div>
                    }
                </div>
                
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
