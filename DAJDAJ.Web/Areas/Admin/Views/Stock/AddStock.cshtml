@model DAJDAJ.Entities.ViewModels.AddStockVM

@{
    ViewData["Title"] = "Add Stock - " + Model.ProductName;
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Add Stock</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Stock Management</a></li>
                    <li class="breadcrumb-item active">Add Stock</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-plus"></i> Add Stock for @Model.ProductName
                </h3>
            </div>
            
            <form asp-action="AddStock" method="post">
                <input type="hidden" asp-for="ProductId" />
                <input type="hidden" asp-for="ProductName" />
                
                <div class="card-body">
                    @if (Model.AvailableColors != null && Model.AvailableColors.Any())
                    {
                        <div class="form-group">
                            <label asp-for="Color" class="control-label">
                                <i class="fas fa-palette"></i> Select Color
                            </label>
                            <select asp-for="Color" class="form-control">
                                <option value="">-- Select a Color --</option>
                                @foreach (var color in Model.AvailableColors)
                                {
                                    <option value="@color">@color</option>
                                }
                            </select>
                            <span asp-validation-for="Color" class="text-danger"></span>
                            <small class="form-text text-muted">
                                Only colors with product images are shown. Colors that already have stock entries are excluded.
                            </small>
                        </div>

                        <div class="form-group">
                            <label asp-for="Quantity" class="control-label">
                                <i class="fas fa-boxes"></i> Quantity
                            </label>
                            <input asp-for="Quantity" type="number" class="form-control" min="0" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                            <small class="form-text text-muted">
                                Set to 0 to mark as "Out of Stock"
                            </small>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            No available colors to add stock. All colors from product images already have stock entries,
                            or no product images exist. 
                            <br><br>
                            <a asp-action="ManageStock" asp-route-productId="@Model.ProductId" class="alert-link">
                                Go to Manage Stock
                            </a> 
                            to update existing stock entries.
                        </div>
                    }
                </div>
                
                <div class="card-footer">
                    @if (Model.AvailableColors != null && Model.AvailableColors.Any())
                    {
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-plus"></i> Add Stock
                        </button>
                    }
                    <a asp-action="ManageStock" asp-route-productId="@Model.ProductId" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Manage Stock
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
