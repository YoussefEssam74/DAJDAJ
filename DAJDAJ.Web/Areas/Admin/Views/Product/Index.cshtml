@{
    ViewBag.PageTitle = "Product Management";
    ViewBag.CardTitle = "Create Product";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

@Html.AntiForgeryToken()

<div class="mb-3 d-grid d-md-block">
    <a class="btn btn-primary" href="/Admin/Product/Create">
        <i class="fas fa-plus"></i> Create New Product
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table id="mytable" class="table table-hover table-striped mb-0" width="100%">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Size</th>
                        <th>Price</th>
                        <th>Color</th>
                        <th>Category</th>
                        <th>Actions</th>
                    </tr>
                </thead>
            </table>
        </div>
    </div>
</div>



@section Scripts {
    <script src="~/js/Product.js"></script>
}
