@model DAJDAJ.Entities.ViewModels.StockManagementVM

@{
    ViewData["Title"] = "Manage Stock - " + Model.ProductName;
}

<div class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1 class="m-0">Manage Stock</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Dashboard</a></li>
                    <li class="breadcrumb-item"><a asp-action="Index">Stock Management</a></li>
                    <li class="breadcrumb-item active">Manage Stock</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section class="content">
    <div class="container-fluid">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="fas fa-box"></i> @Model.ProductName - Stock by Color
                </h3>
                <div class="card-tools">
                    <a asp-action="AddStock" asp-route-productId="@Model.ProductId" class="btn btn-success btn-sm">
                        <i class="fas fa-plus"></i> Add New Color Stock
                    </a>
                </div>
            </div>
            
            <form asp-action="UpdateStock" method="post">
                <input type="hidden" asp-for="ProductId" />
                <input type="hidden" asp-for="ProductName" />
                
                <div class="card-body">
                    @if (Model.ColorStocks.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-bordered table-hover">
                                <thead>
                                    <tr>
                                        <th>Color</th>
                                        <th>Quantity</th>
                                        <th>Status</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int i = 0; i < Model.ColorStocks.Count; i++)
                                    {
                                        <tr>
                                            <td>
                                                <input type="hidden" asp-for="ColorStocks[i].Id" />
                                                <input type="hidden" asp-for="ColorStocks[i].Color" />
                                                <strong>@Model.ColorStocks[i].Color</strong>
                                            </td>
                                            <td>
                                                <input type="number" 
                                                       asp-for="ColorStocks[i].Quantity" 
                                                       class="form-control form-control-sm" 
                                                       min="0" 
                                                       style="max-width: 120px;" />
                                                <span asp-validation-for="ColorStocks[i].Quantity" class="text-danger"></span>
                                            </td>
                                            <td>
                                                @if (Model.ColorStocks[i].IsSoldOut)
                                                {
                                                    <span class="badge badge-danger">
                                                        <i class="fas fa-times-circle"></i> Sold Out
                                                    </span>
                                                }
                                                else if (Model.ColorStocks[i].IsLowStock)
                                                {
                                                    <span class="badge badge-warning">
                                                        <i class="fas fa-exclamation-triangle"></i> Low Stock
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge badge-success">
                                                        <i class="fas fa-check-circle"></i> In Stock
                                                    </span>
                                                }
                                            </td>
                                            <td>
                                                <button type="button" 
                                                        class="btn btn-danger btn-sm delete-stock-btn" 
                                                        data-id="@Model.ColorStocks[i].Id"
                                                        data-color="@Model.ColorStocks[i].Color">
                                                    <i class="fas fa-trash"></i> Delete
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i> No stock records found for this product. 
                            <a asp-action="AddStock" asp-route-productId="@Model.ProductId" class="alert-link">
                                Add stock for available colors
                            </a>
                        </div>
                    }
                </div>
                
                <div class="card-footer">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Save Changes
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to List
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirm Delete</h5>
                <button type="button" class="close" data-dismiss="modal">
                    <span>&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete the stock entry for <strong id="deleteColorName"></strong>?</p>
                <p class="text-warning">
                    <i class="fas fa-exclamation-triangle"></i> This action cannot be undone.
                </p>
            </div>
            <div class="modal-footer">
                <form id="deleteForm" method="post" asp-action="DeleteStock">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteId" />
                    <input type="hidden" name="productId" value="@Model.ProductId" />
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $('.delete-stock-btn').click(function () {
                var id = $(this).data('id');
                var color = $(this).data('color');
                
                $('#deleteId').val(id);
                $('#deleteColorName').text(color);
                $('#deleteModal').modal('show');
            });
        });
    </script>
}
