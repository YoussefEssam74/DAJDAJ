@{
    ViewBag.PageTitle = "Orders Management";
    ViewBag.CardTitle = "View Orders";
    Layout = "~/Views/Shared/_Dashboard.cshtml";
}

<div class="mb-2">
    <a href="@Url.Action("ExportToExcel", "Order", new { area = "Admin" })" class="btn btn-success">
        Export to Excel
    </a>
    <button id="exportCurrentPage" class="btn btn-success">
        Export Current Page to Excel
    </button>
</div>

<div class="card shadow mb-4">
    <div class="card-header py-3">
        <h6 class="m-0 font-weight-bold text-primary">@ViewBag.CardTitle</h6>
    </div>
    <div class="card-body">
        <div class="table-responsive">
            <table id="mytable" class="table table-bordered" width="100%" cellspacing="0">
                <thead class="thead-dark">
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Phone</th>  
                        <th>City</th>
                        <th>Order Status</th>
                        <th>Total Price</th>
                        <th>Actions</th>
                    </tr>
                </thead>

            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Order.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
    $(document).ready(function () {
        $('#exportCurrentPage').on('click', function () {
            var orderIds = [];
            $('#mytable tbody tr:visible').each(function () {
                var id = $(this).find('td:first').text().trim();
                if (id) orderIds.push(id);
            });
            if (orderIds.length > 0) {
                var form = $('<form method="post" action="@Url.Action("ExportSelectedToExcel", "Order", new { area = "Admin" })"></form>');
                orderIds.forEach(function (id) {
                    form.append('<input type="hidden" name="orderIds" value="' + id + '"/>');
                });
                $('body').append(form);
                form.submit();
            } else {
                alert('No orders to export on this page.');
            }
        });
    });
    </script>
}