using Microsoft.AspNetCore.Identity.UI.Services;
using Microsoft.Extensions.Configuration;
using System.Net;
using System.Net.Mail;
using System.Threading.Tasks;
using System.Diagnostics;
using System.Collections.Generic;
using System.Linq;

namespace DAJDAJ.Utilities
{
    public class EmailSender : IEmailSender
    {
        private readonly IConfiguration _configuration;

        public EmailSender(IConfiguration configuration)
        {
            _configuration = configuration;
        }

        // New overload to send to multiple emails
        public async Task SendEmailAsync(IEnumerable<string> emails, string subject, string htmlMessage)
        {
            try
            {
                var smtpServer = _configuration["EmailSettings:SmtpServer"];
                var smtpPort = int.Parse(_configuration["EmailSettings:SmtpPort"]);
                var senderEmail = _configuration["EmailSettings:SenderEmail"];
                var senderPassword = _configuration["EmailSettings:SenderPassword"];
                var senderName = _configuration["EmailSettings:SenderName"];

                var smtpClient = new SmtpClient(smtpServer)
                {
                    Port = smtpPort,
                    Credentials = new NetworkCredential(senderEmail, senderPassword),
                    EnableSsl = true,
                };

                var mailMessage = new MailMessage
                {
                    From = new MailAddress(senderEmail, senderName),
                    Subject = subject,
                    Body = htmlMessage,
                    IsBodyHtml = true,
                };

                foreach (var email in emails)
                {
                    mailMessage.To.Add(email);
                }

                await smtpClient.SendMailAsync(mailMessage);
            }
            catch (System.Exception ex)
            {
                Debug.WriteLine($"Email send error: {ex.Message}");
                throw;
            }
        }

        // Keep the original single-email method for compatibility
        public async Task SendEmailAsync(string email, string subject, string htmlMessage)
        {
            await SendEmailAsync(new List<string> { email }, subject, htmlMessage);
        }

        // New method to send to all admin emails
        public async Task SendEmailToAdminsAsync(string subject, string htmlMessage)
        {
            var adminEmails = _configuration.GetSection("EmailSettings:AdminEmails").Get<List<string>>();

            if (adminEmails == null || !adminEmails.Any())
            {
                Debug.WriteLine("No admin emails configured.");
                return;
            }

            await SendEmailAsync(adminEmails, subject, htmlMessage);
        }
    }
}
